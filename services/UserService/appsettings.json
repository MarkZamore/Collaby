{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=collaby_users;Username=${POSTGRES_USERS_USER};Password=${POSTGRES_USERS_PASSWORD};"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}"
  },
  "IdentityService": {
    "BaseUrl": "http://access:5001",
    "CallerService": "user-service",
    "InternalApiKey": "${INTERNAL_AUTH_USER_TO_IDENTITY_KEY}"
  },
  "InternalAuth": {
    "AllowedCallers": {
      "identity-service": "${INTERNAL_AUTH_IDENTITY_TO_USER_KEY}",
      "management-service": "${INTERNAL_AUTH_MANAGEMENT_TO_USER_KEY}",
      "messenger-service": "${INTERNAL_AUTH_MESSENGER_TO_USER_KEY}",
      "call-service": "${INTERNAL_AUTH_CALL_TO_USER_KEY}",
      "gamification-service": "${INTERNAL_AUTH_GAMIFICATION_TO_USER_KEY}",
      "analytics-service": "${INTERNAL_AUTH_ANALYTICS_TO_USER_KEY}",
      "ai-service": "${INTERNAL_AUTH_AI_TO_USER_KEY}"
    }
  }
}
