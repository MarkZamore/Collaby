{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://${MONGO_CALLS_USER}:${MONGO_CALLS_PASSWORD}@mongo-db:27017/collaby_calls?authSource=collaby_calls",
    "Redis": "cache:6379,user=${REDIS_CALLS_USER},password=${REDIS_CALLS_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}"
  },
  "UserService": {
    "BaseUrl": "http://access:5001",
    "CallerService": "call-service",
    "InternalApiKey": "${INTERNAL_AUTH_CALL_TO_USER_KEY}"
  },
  "MessengerService": {
    "BaseUrl": "http://realtime:5004",
    "CallerService": "call-service",
    "InternalApiKey": "${INTERNAL_AUTH_CALL_TO_MESSENGER_KEY}"
  },
  "InternalAuth": {
    "AllowedCallers": {
      "identity-service": "${INTERNAL_AUTH_IDENTITY_TO_CALL_KEY}"
    }
  }
}
