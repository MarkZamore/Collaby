{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=collaby_gamification;Username=${POSTGRES_GAMIFICATION_USER};Password=${POSTGRES_GAMIFICATION_PASSWORD};",
    "Mongo": "mongodb://${MONGO_GAMIFICATION_USER}:${MONGO_GAMIFICATION_PASSWORD}@mongo-db:27017/collaby_gamification?authSource=collaby_gamification",
    "Redis": "cache:6379,user=${REDIS_GAMIFICATION_USER},password=${REDIS_GAMIFICATION_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}"
  },
  "InternalAuth": {
    "AllowedCallers": {
      "identity-service": "${INTERNAL_AUTH_IDENTITY_TO_GAMIFICATION_KEY}",
      "management-service": "${INTERNAL_AUTH_MANAGEMENT_TO_GAMIFICATION_KEY}"
    }
  },
  "UserService": {
    "BaseUrl": "http://access:5001",
    "CallerService": "gamification-service",
    "InternalApiKey": "${INTERNAL_AUTH_GAMIFICATION_TO_USER_KEY}"
  },
  "ManagementService": {
    "BaseUrl": "http://workspace:5003",
    "CallerService": "gamification-service",
    "InternalApiKey": "${INTERNAL_AUTH_GAMIFICATION_TO_MANAGEMENT_KEY}"
  }
}
