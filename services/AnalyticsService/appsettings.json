{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=collaby_analytics;Username=${POSTGRES_ANALYTICS_USER};Password=${POSTGRES_ANALYTICS_PASSWORD};"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}"
  },
  "UserService": {
    "BaseUrl": "http://access:5001",
    "CallerService": "analytics-service",
    "InternalApiKey": "${INTERNAL_AUTH_ANALYTICS_TO_USER_KEY}"
  },
  "ManagementService": {
    "BaseUrl": "http://workspace:5003",
    "CallerService": "analytics-service",
    "InternalApiKey": "${INTERNAL_AUTH_ANALYTICS_TO_MANAGEMENT_KEY}"
  }
}
