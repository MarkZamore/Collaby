{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=collaby_identity;Username=${POSTGRES_IDENTITY_USER};Password=${POSTGRES_IDENTITY_PASSWORD};",
    "Mongo": "mongodb://${MONGO_IDENTITY_USER}:${MONGO_IDENTITY_PASSWORD}@mongo-db:27017/identity_logs?authSource=identity_logs",
    "Redis": "cache:6379,user=${REDIS_IDENTITY_USER},password=${REDIS_IDENTITY_PASSWORD}"
  },
  "Mongo": {
    "Database": "identity_logs"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14
  },
  "Google": {
    "ClientId": ""
  },
  "AnalyticsService": {
    "Enabled": true
  },
  "Email": {
    "SmtpHost": "${SMTP_HOST}",
    "SmtpPort": 587,
    "SmtpUsername": "${SMTP_USERNAME}",
    "SmtpPassword": "${SMTP_PASSWORD}",
    "SenderEmail": "${SENDER_EMAIL}",
    "SenderName": "Collaby"
  },
  "InternalAuth": {
    "AllowedCallers": {
      "user-service": "${INTERNAL_AUTH_USER_TO_IDENTITY_KEY}"
    }
  }
}
