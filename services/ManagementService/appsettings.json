{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=collaby_management;Username=${POSTGRES_MANAGEMENT_USER};Password=${POSTGRES_MANAGEMENT_PASSWORD};",
    "Redis": "cache:6379,user=${REDIS_MANAGEMENT_USER},password=${REDIS_MANAGEMENT_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}"
  },
  "UserService": {
    "BaseUrl": "http://access:5001",
    "CallerService": "management-service",
    "InternalApiKey": "${INTERNAL_AUTH_MANAGEMENT_TO_USER_KEY}"
  },
  "InternalAuth": {
    "AllowedCallers": {
      "identity-service": "${INTERNAL_AUTH_IDENTITY_TO_MANAGEMENT_KEY}",
      "gamification-service": "${INTERNAL_AUTH_GAMIFICATION_TO_MANAGEMENT_KEY}",
      "analytics-service": "${INTERNAL_AUTH_ANALYTICS_TO_MANAGEMENT_KEY}",
      "ai-service": "${INTERNAL_AUTH_AI_TO_MANAGEMENT_KEY}"
    }
  }
}
