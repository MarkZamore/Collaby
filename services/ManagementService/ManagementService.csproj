<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ManagementService.Tests/**/*.cs" />
    <Content Remove="ManagementService.Tests/**" />
    <EmbeddedResource Remove="ManagementService.Tests/**" />
    <None Remove="ManagementService.Tests/**" />
    <Compile Remove="ManagementService.Platform/**/*.cs" />
    <Content Remove="ManagementService.Platform/**" />
    <EmbeddedResource Remove="ManagementService.Platform/**" />
    <None Remove="ManagementService.Platform/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../platform/dotnet/Collaby.EventBus/Collaby.EventBus.csproj" />
    <ProjectReference Include="../../platform/dotnet/Collaby.ServiceDefaults/Collaby.ServiceDefaults.csproj" />
    <ProjectReference Include="../../platform/dotnet/Collaby.InternalContracts/Collaby.InternalContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\platform\contracts\runtime\service-catalog.json">
      <Link>service-catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\frontend\src\shared\locales\en\landing.json">
      <Link>cms-defaults/landing/en.json</Link>
      <TargetPath>cms-defaults/landing/en.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\frontend\src\shared\locales\ru\landing.json">
      <Link>cms-defaults/landing/ru.json</Link>
      <TargetPath>cms-defaults/landing/ru.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\frontend\src\shared\locales\kk\landing.json">
      <Link>cms-defaults/landing/kk.json</Link>
      <TargetPath>cms-defaults/landing/kk.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(COLLABY_HOST_WRAPPER_BUILD)' == 'true'">
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
