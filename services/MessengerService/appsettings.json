{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://${MONGO_MESSENGER_USER}:${MONGO_MESSENGER_PASSWORD}@mongo-db:27017/collaby_messenger?authSource=collaby_messenger",
    "Redis": "cache:6379,user=${REDIS_MESSENGER_USER},password=${REDIS_MESSENGER_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "collaby-identity",
    "Audience": "collaby-clients",
    "SigningKey": "${IDENTITY_JWT_KEY}"
  },
  "UserService": {
    "BaseUrl": "http://access:5001",
    "CallerService": "messenger-service",
    "InternalApiKey": "${INTERNAL_AUTH_MESSENGER_TO_USER_KEY}"
  },
  "InternalAuth": {
    "AllowedCallers": {
      "identity-service": "${INTERNAL_AUTH_IDENTITY_TO_MESSENGER_KEY}",
      "call-service": "${INTERNAL_AUTH_CALL_TO_MESSENGER_KEY}"
    }
  }
}
