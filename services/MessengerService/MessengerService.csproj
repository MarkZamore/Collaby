<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MessengerService.Tests/**/*.cs" />
    <Content Remove="MessengerService.Tests/**" />
    <EmbeddedResource Remove="MessengerService.Tests/**" />
    <None Remove="MessengerService.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../platform/dotnet/Collaby.EventBus/Collaby.EventBus.csproj" />
    <ProjectReference Include="../../platform/dotnet/Collaby.ServiceDefaults/Collaby.ServiceDefaults.csproj" />
    <ProjectReference Include="../../platform/dotnet/Collaby.InternalContracts/Collaby.InternalContracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(COLLABY_HOST_WRAPPER_BUILD)' == 'true'">
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
