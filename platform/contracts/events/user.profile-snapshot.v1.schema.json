{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaby.local/contracts/events/user.profile-snapshot.v1.schema.json",
  "title": "user.profile-snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "displayName"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "avatarUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "locale": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
