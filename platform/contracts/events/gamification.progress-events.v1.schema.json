{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaby.local/contracts/events/gamification.progress-events.v1.schema.json",
  "title": "gamification.progress-events.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "xpDelta",
    "coinsDelta",
    "levelAfterEvent"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "xpDelta": {
      "type": "integer"
    },
    "coinsDelta": {
      "type": "integer"
    },
    "levelAfterEvent": {
      "type": "integer",
      "minimum": 0
    },
    "rewardCode": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
