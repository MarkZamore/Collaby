{
  "postgres": {
    "image": "${COLLABY_REGISTRY:-collaby}/postgres:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "POSTGRES_DB": "postgres",
      "POSTGRES_USER": "${POSTGRES_USER}",
      "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
      "POSTGRES_IDENTITY_USER": "${POSTGRES_IDENTITY_USER}",
      "POSTGRES_IDENTITY_PASSWORD": "${POSTGRES_IDENTITY_PASSWORD}",
      "POSTGRES_USERS_USER": "${POSTGRES_USERS_USER}",
      "POSTGRES_USERS_PASSWORD": "${POSTGRES_USERS_PASSWORD}",
      "POSTGRES_MANAGEMENT_USER": "${POSTGRES_MANAGEMENT_USER}",
      "POSTGRES_MANAGEMENT_PASSWORD": "${POSTGRES_MANAGEMENT_PASSWORD}",
      "POSTGRES_GAMIFICATION_USER": "${POSTGRES_GAMIFICATION_USER}",
      "POSTGRES_GAMIFICATION_PASSWORD": "${POSTGRES_GAMIFICATION_PASSWORD}",
      "POSTGRES_ANALYTICS_USER": "${POSTGRES_ANALYTICS_USER}",
      "POSTGRES_ANALYTICS_PASSWORD": "${POSTGRES_ANALYTICS_PASSWORD}"
    },
    "build": {
      "context": "./database/postgres",
      "dockerfile": "Dockerfile"
    },
    "volumes": [
      "postgres_data:/var/lib/postgresql/data"
    ]
  },
  "mongo-db": {
    "image": "${COLLABY_REGISTRY:-collaby}/mongo-db:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "MONGO_INITDB_ROOT_USERNAME": "${MONGO_INITDB_ROOT_USERNAME}",
      "MONGO_INITDB_ROOT_PASSWORD": "${MONGO_INITDB_ROOT_PASSWORD}",
      "MONGO_INITDB_DATABASE": "admin",
      "MONGO_IDENTITY_USER": "${MONGO_IDENTITY_USER}",
      "MONGO_IDENTITY_PASSWORD": "${MONGO_IDENTITY_PASSWORD}",
      "MONGO_MESSENGER_USER": "${MONGO_MESSENGER_USER}",
      "MONGO_MESSENGER_PASSWORD": "${MONGO_MESSENGER_PASSWORD}",
      "MONGO_CALLS_USER": "${MONGO_CALLS_USER}",
      "MONGO_CALLS_PASSWORD": "${MONGO_CALLS_PASSWORD}",
      "MONGO_GAMIFICATION_USER": "${MONGO_GAMIFICATION_USER}",
      "MONGO_GAMIFICATION_PASSWORD": "${MONGO_GAMIFICATION_PASSWORD}"
    },
    "build": {
      "context": "./database/mongodb",
      "dockerfile": "Dockerfile"
    },
    "volumes": [
      "mongo_data:/data/db",
      "mongo_config:/data/configdb"
    ],
    "command": [
      "mongod",
      "--wiredTigerCacheSizeGB",
      "0.25",
      "--bind_ip_all"
    ]
  },
  "cache": {
    "image": "${COLLABY_REGISTRY:-collaby}/cache:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "REDIS_ADMIN_USER": "${REDIS_ADMIN_USER:-redis-admin}",
      "REDIS_ADMIN_PASSWORD": "${REDIS_ADMIN_PASSWORD}",
      "REDIS_IDENTITY_USER": "${REDIS_IDENTITY_USER}",
      "REDIS_IDENTITY_PASSWORD": "${REDIS_IDENTITY_PASSWORD}",
      "REDIS_MANAGEMENT_USER": "${REDIS_MANAGEMENT_USER}",
      "REDIS_MANAGEMENT_PASSWORD": "${REDIS_MANAGEMENT_PASSWORD}",
      "REDIS_MESSENGER_USER": "${REDIS_MESSENGER_USER}",
      "REDIS_MESSENGER_PASSWORD": "${REDIS_MESSENGER_PASSWORD}",
      "REDIS_CALLS_USER": "${REDIS_CALLS_USER}",
      "REDIS_CALLS_PASSWORD": "${REDIS_CALLS_PASSWORD}",
      "REDIS_GAMIFICATION_USER": "${REDIS_GAMIFICATION_USER}",
      "REDIS_GAMIFICATION_PASSWORD": "${REDIS_GAMIFICATION_PASSWORD}"
    },
    "build": {
      "context": "./database/redis",
      "dockerfile": "Dockerfile"
    },
    "volumes": [
      "cache_data:/data"
    ]
  },
  "events": {
    "image": "${COLLABY_EVENTS_IMAGE:-bitnamilegacy/kafka:4.0.0@sha256:f45d5b813412e1ef7ce67b467309a84e4c6dc03d7626a0b6da867db9b69bd107}",
    "environment": {
      "KAFKA_ENABLE_KRAFT": "yes",
      "KAFKA_CFG_PROCESS_ROLES": "broker,controller",
      "KAFKA_CFG_NODE_ID": "1",
      "KAFKA_CFG_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
      "KAFKA_CFG_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093",
      "KAFKA_CFG_ADVERTISED_LISTENERS": "PLAINTEXT://events:9092",
      "KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP": "PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT",
      "KAFKA_CFG_CONTROLLER_QUORUM_VOTERS": "1@events:9093",
      "KAFKA_CFG_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
      "KAFKA_CFG_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1",
      "KAFKA_CFG_TRANSACTION_STATE_LOG_MIN_ISR": "1",
      "KAFKA_CFG_NUM_PARTITIONS": "3",
      "KAFKA_CFG_AUTO_CREATE_TOPICS_ENABLE": "false",
      "KAFKA_KRAFT_CLUSTER_ID": "${COLLABY_KAFKA_CLUSTER_ID:-MkU3OEVBNTcwNTJENDM2Qk}",
      "ALLOW_PLAINTEXT_LISTENER": "yes",
      "KAFKA_HEAP_OPTS": "-Xms256m -Xmx384m",
      "KAFKA_CFG_LOG_RETENTION_HOURS": "72",
      "KAFKA_CFG_LOG_RETENTION_BYTES": "536870912"
    },
    "build": null,
    "volumes": [
      "events_data:/bitnami/kafka"
    ]
  },
  "access": {
    "image": "${COLLABY_REGISTRY:-collaby}/access:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "ASPNET_ENVIRONMENT": "Production",
      "ASPNETCORE_URLS": "http://+:5001",
      "Kafka__BootstrapServers": "events:9092",
      "ConnectionStrings__IdentityPostgres": "Host=postgres;Port=5432;Database=collaby_identity;Username=${POSTGRES_IDENTITY_USER};Password=${POSTGRES_IDENTITY_PASSWORD};",
      "ConnectionStrings__UsersPostgres": "Host=postgres;Port=5432;Database=collaby_users;Username=${POSTGRES_USERS_USER};Password=${POSTGRES_USERS_PASSWORD};",
      "ConnectionStrings__Mongo": "mongodb://${MONGO_IDENTITY_USER}:${MONGO_IDENTITY_PASSWORD}@mongo-db:27017/identity_logs?authSource=identity_logs",
      "ConnectionStrings__Redis": "cache:6379,user=${REDIS_IDENTITY_USER},password=${REDIS_IDENTITY_PASSWORD}",
      "Jwt__Issuer": "collaby-identity",
      "Jwt__Audience": "collaby-clients",
      "Jwt__SigningKey": "${IDENTITY_JWT_KEY}",
      "Google__ClientId": "${GOOGLE_CLIENT_ID}",
      "Email__SmtpHost": "mailpit",
      "Email__SmtpPort": "1025",
      "Email__SmtpUsername": "",
      "Email__SmtpPassword": "",
      "Email__SenderEmail": "noreply@collaby.local",
      "Email__SenderName": "Collaby",
      "SYSTEM_ADMIN_EMAILS": "${SYSTEM_ADMIN_EMAILS:-}",
      "InternalAuth__AllowedCallers__management-service": "${INTERNAL_AUTH_MANAGEMENT_TO_USER_KEY}",
      "InternalAuth__AllowedCallers__analytics-service": "${INTERNAL_AUTH_ANALYTICS_TO_USER_KEY}",
      "InternalAuth__AllowedCallers__messenger-service": "${INTERNAL_AUTH_MESSENGER_TO_USER_KEY}",
      "InternalAuth__AllowedCallers__call-service": "${INTERNAL_AUTH_CALL_TO_USER_KEY}",
      "InternalAuth__AllowedCallers__gamification-service": "${INTERNAL_AUTH_GAMIFICATION_TO_USER_KEY}",
      "InternalAuth__AllowedCallers__ai-service": "${INTERNAL_AUTH_AI_TO_USER_KEY}",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel:4317",
      "Email__UseTls": "false",
      "Frontend__BaseUrl": "http://localhost:8080",
      "Cookies__Secure": "false"
    },
    "build": {
      "context": ".",
      "dockerfile": "services/AccessHost/Dockerfile"
    },
    "volumes": []
  },
  "workspace": {
    "image": "${COLLABY_REGISTRY:-collaby}/workspace:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "ASPNET_ENVIRONMENT": "Production",
      "ASPNETCORE_URLS": "http://+:5003",
      "Kafka__BootstrapServers": "events:9092",
      "ConnectionStrings__ManagementPostgres": "Host=postgres;Port=5432;Database=collaby_management;Username=${POSTGRES_MANAGEMENT_USER};Password=${POSTGRES_MANAGEMENT_PASSWORD};",
      "ConnectionStrings__AnalyticsPostgres": "Host=postgres;Port=5432;Database=collaby_analytics;Username=${POSTGRES_ANALYTICS_USER};Password=${POSTGRES_ANALYTICS_PASSWORD};",
      "ConnectionStrings__Redis": "cache:6379,user=${REDIS_MANAGEMENT_USER},password=${REDIS_MANAGEMENT_PASSWORD}",
      "Jwt__Issuer": "collaby-identity",
      "Jwt__Audience": "collaby-clients",
      "Jwt__SigningKey": "${IDENTITY_JWT_KEY}",
      "ManagementService__UserService__BaseUrl": "http://access:5001",
      "ManagementService__UserService__CallerService": "management-service",
      "ManagementService__UserService__InternalApiKey": "${INTERNAL_AUTH_MANAGEMENT_TO_USER_KEY}",
      "AnalyticsService__UserService__BaseUrl": "http://access:5001",
      "AnalyticsService__UserService__CallerService": "analytics-service",
      "AnalyticsService__UserService__InternalApiKey": "${INTERNAL_AUTH_ANALYTICS_TO_USER_KEY}",
      "Unsplash__AccessKey": "${UNSPLASH_ACCESS_KEY:-}",
      "SYSTEM_ADMIN_EMAILS": "${SYSTEM_ADMIN_EMAILS:-}",
      "InternalAuth__AllowedCallers__gamification-service": "${INTERNAL_AUTH_GAMIFICATION_TO_MANAGEMENT_KEY}",
      "InternalAuth__AllowedCallers__ai-service": "${INTERNAL_AUTH_AI_TO_MANAGEMENT_KEY}",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel:4317",
      "Email__SmtpHost": "mailpit",
      "Email__SmtpPort": "1025",
      "Email__SenderEmail": "noreply@collaby.local",
      "Frontend__BaseUrl": "http://localhost:8080",
      "Kubernetes__Namespace": "collaby"
    },
    "build": {
      "context": ".",
      "dockerfile": "services/WorkspaceHost/Dockerfile"
    },
    "volumes": []
  },
  "realtime": {
    "image": "${COLLABY_REGISTRY:-collaby}/realtime:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "ASPNET_ENVIRONMENT": "Production",
      "ASPNETCORE_URLS": "http://+:5004",
      "Kafka__BootstrapServers": "events:9092",
      "ConnectionStrings__MessengerMongo": "mongodb://${MONGO_MESSENGER_USER}:${MONGO_MESSENGER_PASSWORD}@mongo-db:27017/collaby_messenger?authSource=collaby_messenger",
      "ConnectionStrings__MessengerRedis": "cache:6379,user=${REDIS_MESSENGER_USER},password=${REDIS_MESSENGER_PASSWORD}",
      "ConnectionStrings__CallsMongo": "mongodb://${MONGO_CALLS_USER}:${MONGO_CALLS_PASSWORD}@mongo-db:27017/collaby_calls?authSource=collaby_calls",
      "ConnectionStrings__CallsRedis": "cache:6379,user=${REDIS_CALLS_USER},password=${REDIS_CALLS_PASSWORD}",
      "Jwt__Issuer": "collaby-identity",
      "Jwt__Audience": "collaby-clients",
      "Jwt__SigningKey": "${IDENTITY_JWT_KEY}",
      "MessengerService__UserService__BaseUrl": "http://access:5001",
      "MessengerService__UserService__CallerService": "messenger-service",
      "MessengerService__UserService__InternalApiKey": "${INTERNAL_AUTH_MESSENGER_TO_USER_KEY}",
      "CallService__UserService__BaseUrl": "http://access:5001",
      "CallService__UserService__CallerService": "call-service",
      "CallService__UserService__InternalApiKey": "${INTERNAL_AUTH_CALL_TO_USER_KEY}",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel:4317"
    },
    "build": {
      "context": ".",
      "dockerfile": "services/RealtimeHost/Dockerfile"
    },
    "volumes": []
  },
  "engagement": {
    "image": "${COLLABY_REGISTRY:-collaby}/engagement:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "ASPNET_ENVIRONMENT": "Production",
      "ASPNETCORE_URLS": "http://+:5006",
      "Kafka__BootstrapServers": "events:9092",
      "ConnectionStrings__Postgres": "Host=postgres;Port=5432;Database=collaby_gamification;Username=${POSTGRES_GAMIFICATION_USER};Password=${POSTGRES_GAMIFICATION_PASSWORD};",
      "ConnectionStrings__Mongo": "mongodb://${MONGO_GAMIFICATION_USER}:${MONGO_GAMIFICATION_PASSWORD}@mongo-db:27017/collaby_gamification?authSource=collaby_gamification",
      "ConnectionStrings__Redis": "cache:6379,user=${REDIS_GAMIFICATION_USER},password=${REDIS_GAMIFICATION_PASSWORD}",
      "Jwt__Issuer": "collaby-identity",
      "Jwt__Audience": "collaby-clients",
      "Jwt__SigningKey": "${IDENTITY_JWT_KEY}",
      "UserService__BaseUrl": "http://access:5001",
      "UserService__CallerService": "gamification-service",
      "UserService__InternalApiKey": "${INTERNAL_AUTH_GAMIFICATION_TO_USER_KEY}",
      "ManagementService__BaseUrl": "http://workspace:5003",
      "ManagementService__CallerService": "gamification-service",
      "ManagementService__InternalApiKey": "${INTERNAL_AUTH_GAMIFICATION_TO_MANAGEMENT_KEY}",
      "InternalAuth__AllowedCallers__management-service": "${INTERNAL_AUTH_MANAGEMENT_TO_GAMIFICATION_KEY}",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel:4317"
    },
    "build": {
      "context": ".",
      "dockerfile": "services/GamificationService/Dockerfile"
    },
    "volumes": []
  },
  "assistant": {
    "image": "${COLLABY_REGISTRY:-collaby}/assistant:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {
      "IDENTITY_JWT_KEY": "${IDENTITY_JWT_KEY}",
      "MANAGEMENT_SERVICE_URL": "http://workspace:5003",
      "USER_SERVICE_URL": "http://access:5001",
      "AI_INTERNAL_SERVICE_NAME": "ai-service",
      "INTERNAL_AUTH_AI_TO_MANAGEMENT_KEY": "${INTERNAL_AUTH_AI_TO_MANAGEMENT_KEY:-}",
      "INTERNAL_AUTH_AI_TO_USER_KEY": "${INTERNAL_AUTH_AI_TO_USER_KEY:-}",
      "AI_STATE_DIR": "/srv/ai-state",
      "AI_MODEL_DIR": "/srv/ai-state/models",
      "AI_ADAPTERS_DIR": "/srv/ai-state/adapters",
      "AI_MODEL_MANIFEST_PATH": "/app/model-manifest.json",
      "AI_ADAPTER_MANIFEST_PATH": "/app/adapter-manifest.json",
      "AI_MODEL_FILE": "${AI_MODEL_FILE:-qwen2.5-1.5b-instruct-q5_k_m.gguf}",
      "AI_MODEL_NAME": "${AI_MODEL_NAME:-Qwen2.5-1.5B-Instruct}",
      "AI_INFERENCE_BACKEND": "${AI_INFERENCE_BACKEND:-local-qwen-gguf}",
      "AI_LLM_CONTEXT_TOKENS": "${AI_LLM_CONTEXT_TOKENS:-2048}",
      "AI_LLM_GPU_LAYERS": "0",
      "AI_ASR_DEVICE": "${AI_ASR_DEVICE:-cpu}",
      "AI_ASR_COMPUTE_TYPE": "${AI_ASR_COMPUTE_TYPE:-int8}",
      "AI_SKIP_ASSET_BOOTSTRAP": "${AI_SKIP_ASSET_BOOTSTRAP:-false}",
      "AI_SKIP_ADAPTER_BOOTSTRAP": "${AI_SKIP_ADAPTER_BOOTSTRAP:-false}",
      "AI_EXTERNAL_SEARCH_ENABLED": "${AI_EXTERNAL_SEARCH_ENABLED:-true}",
      "COLLABY_PUBLIC_BASE_URL": "http://localhost:8080",
      "HF_HOME": "/srv/ai-state/huggingface",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel:4317",
      "AI_REQUIRE_ADAPTER": "true",
      "AI_LLM_THREADS": "6"
    },
    "build": {
      "context": "./services/AgentService",
      "dockerfile": "Dockerfile"
    },
    "volumes": [
      "ai-state:/srv/ai-state"
    ]
  },
  "frontend": {
    "image": "${COLLABY_REGISTRY:-collaby}/frontend:${COLLABY_IMAGE_TAG:-latest}",
    "environment": {},
    "build": {
      "context": ".",
      "dockerfile": "frontend/Dockerfile",
      "args": {
        "VITE_API_BASE_URL": "${VITE_API_BASE_URL:-/api}",
        "VITE_API_TIMEOUT": "${VITE_API_TIMEOUT:-10000}",
        "VITE_BUILD_ID": "${VITE_BUILD_ID:-}",
        "VITE_COMMIT_SHA": "${VITE_COMMIT_SHA:-}",
        "VITE_REF_NAME": "${VITE_REF_NAME:-}",
        "VITE_BUILD_TIMESTAMP": "${VITE_BUILD_TIMESTAMP:-}"
      }
    },
    "volumes": []
  },
  "mongo": {
    "image": "${COLLABY_PANEL_MONGO_IMAGE:-mongo-express:1.0.2-20-alpine3.19@sha256:1aae0077525133249133d42980ba23998712a1077e02ac0ac295b50a7a79d550}",
    "environment": {
      "ME_CONFIG_BASICAUTH": "true",
      "ME_CONFIG_MONGODB_ENABLE_ADMIN": "true",
      "ME_CONFIG_MONGODB_URL": "mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo-db:27017/?authSource=admin",
      "ME_CONFIG_SITE_BASEURL": "/",
      "ME_CONFIG_BASICAUTH_USERNAME": "admin",
      "ME_CONFIG_BASICAUTH_PASSWORD": "${PANEL_PASSWORD}"
    },
    "volumes": [],
    "command": null
  },
  "pg": {
    "image": "${COLLABY_PANEL_PG_IMAGE:-dpage/pgadmin4:9.15.0@sha256:cefc4cc6b7d9d71a9e81e76fb9d7e14038ab5661b539a190eea1b63fa612589a}",
    "environment": {
      "PGADMIN_DEFAULT_EMAIL": "${PGADMIN_DEFAULT_EMAIL:-admin@collaby.org}",
      "PGADMIN_DEFAULT_PASSWORD": "${PANEL_PASSWORD}",
      "PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED": "False",
      "PGADMIN_CONFIG_AUTHENTICATION_SOURCES": "['internal']",
      "PGADMIN_REPLACE_SERVERS_ON_STARTUP": "True",
      "PGADMIN_SERVER_JSON_FILE": "/pgadmin4/servers.json"
    },
    "volumes": [
      "pg_data:/var/lib/pgadmin",
      "${COLLABY_PG_SERVERS_FILE:-./panels/pg/servers.json}:/pgadmin4/servers.json:ro"
    ],
    "command": null
  },
  "redis": {
    "image": "${COLLABY_PANEL_REDIS_IMAGE:-redis/redisinsight:3.4.2@sha256:85562d67a9128ac7f764bb3d1ac909fcf77708c7c8f55bd1605a85b3c4becc83}",
    "environment": {
      "RI_ACCEPT_TERMS_AND_CONDITIONS": "true",
      "RI_REDIS_HOST": "${COLLABY_PANEL_REDIS_HOST:-cache}",
      "RI_REDIS_PORT": "${COLLABY_PANEL_REDIS_PORT:-6379}",
      "RI_REDIS_ALIAS": "${COLLABY_PANEL_REDIS_ALIAS:-Collaby Shared Cache}",
      "RI_REDIS_USERNAME": "${REDIS_ADMIN_USER:-redis-admin}",
      "RI_REDIS_PASSWORD": "${REDIS_ADMIN_PASSWORD}",
      "RI_REDIS_DB": "0"
    },
    "volumes": [
      "redis_data:/data"
    ],
    "command": null
  },
  "portainer": {
    "image": "${COLLABY_PANEL_PORTAINER_IMAGE:-portainer/portainer-ce:2.42.0@sha256:c3c919ec68d130cbcb837693420592b91afd320b28b492c16c84ec5561bbf095}",
    "environment": {},
    "volumes": [
      "portainer_data:/data"
    ],
    "command": [
      "--http-enabled"
    ]
  },
  "loki": {
    "image": "${COLLABY_PANEL_LOKI_IMAGE:-grafana/loki:3.7.2@sha256:191d4fdfb7264f16989f0a57f320872620a5a7c2ceeec6229212c4190ec49b86}",
    "environment": {},
    "volumes": [
      "loki_data:/loki",
      "${COLLABY_LOKI_CONFIG_FILE:-./panels/grafana/loki-config.yml}:/etc/loki/loki-config.yml:ro"
    ],
    "command": "-config.file=/etc/loki/loki-config.yml"
  },
  "tempo": {
    "image": "${COLLABY_PANEL_TEMPO_IMAGE:-grafana/tempo:2.10.5@sha256:ee21727732c7a7199cb71c3eee9153bbf23f9b0b87619f0555a0cf21a67f1a33}",
    "environment": {},
    "volumes": [
      "tempo_data:/var/tempo",
      "${COLLABY_TEMPO_CONFIG_FILE:-./panels/grafana/tempo-config.yml}:/etc/tempo/config.yml:ro"
    ],
    "command": "-config.file=/etc/tempo/config.yml"
  },
  "otel": {
    "image": "${COLLABY_PANEL_OTEL_COLLECTOR_IMAGE:-otel/opentelemetry-collector-contrib:0.153.0@sha256:93aad750175cbf1a973ae1c5886c3371f4d800f61be25cdd26870b8441ffe9fa}",
    "environment": {},
    "volumes": [
      "${COLLABY_OTEL_COLLECTOR_CONFIG_FILE:-./panels/grafana/otel-collector-config.yml}:/etc/otel-collector/config.yml:ro"
    ],
    "command": [
      "--config=/etc/otel-collector/config.yml"
    ]
  },
  "prometheus": {
    "image": "${COLLABY_PANEL_PROMETHEUS_IMAGE:-prom/prometheus:v3.12.0@sha256:69f5241418838263316593f7274a304b095c40bcf22e57272865da91bd60a8ac}",
    "environment": {},
    "volumes": [
      "prometheus_data:/prometheus",
      "${COLLABY_PROMETHEUS_CONFIG_FILE:-./panels/grafana/prometheus-config.yml}:/etc/prometheus/prometheus.yml:ro"
    ],
    "command": [
      "--config.file=/etc/prometheus/prometheus.yml",
      "--storage.tsdb.path=/prometheus",
      "--storage.tsdb.retention.time=3d",
      "--storage.tsdb.retention.size=512MB"
    ]
  },
  "grafana": {
    "image": "${COLLABY_PANEL_GRAFANA_IMAGE:-grafana/grafana:12.4.4@sha256:378f94b054e5384cd74322cbf7542cff6a43e068e4011f81ea5e75323247df02}",
    "environment": {
      "GF_SECURITY_ADMIN_USER": "${GRAFANA_ADMIN_USER:-admin}",
      "GF_SECURITY_ADMIN_PASSWORD": "${PANEL_PASSWORD}",
      "GF_SERVER_DOMAIN": "localhost",
      "GF_SERVER_ROOT_URL": "http://localhost:3001",
      "GF_AUTH_DISABLE_LOGIN_FORM": "false",
      "GF_AUTH_PROXY_ENABLED": "false",
      "GF_SECURITY_ALLOW_EMBEDDING": "true"
    },
    "volumes": [
      "grafana_data:/var/lib/grafana",
      "${COLLABY_GRAFANA_DATASOURCES_FILE:-./panels/grafana/loki.yml}:/etc/grafana/provisioning/datasources/loki.yml:ro"
    ],
    "command": null
  },
  "server": {
    "image": "${COLLABY_PANEL_SERVER_IMAGE:-netdata/netdata:v2.10.3@sha256:bcc822ec685dd7ee488e9f99b957f479b66301be04f13f346df692ad7de94151}",
    "environment": {
      "DO_NOT_TRACK": "1"
    },
    "volumes": [
      "server_lib:/var/lib/netdata",
      "server_cache:/var/cache/netdata"
    ],
    "command": null
  },
  "kafka": {
    "image": "${COLLABY_PANEL_KAFKA_IMAGE:-provectuslabs/kafka-ui@sha256:8f2ff02d64b0a7a2b71b6b3b3148b85f66d00ec20ad40c30bdcd415d46d31818}",
    "environment": {
      "KAFKA_CLUSTERS_0_NAME": "${COLLABY_PANEL_KAFKA_CLUSTER_NAME:-Collaby Kafka}",
      "KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS": "${COLLABY_PANEL_KAFKA_BOOTSTRAP_SERVERS:-events:9092}",
